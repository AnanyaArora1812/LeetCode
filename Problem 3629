from collections import defaultdict, deque

class Solution:
    def minJumps(self, nums):
        n = len(nums)

        MAXV = max(nums) + 1

        spf = list(range(MAXV))

        for i in range(2, int(MAXV ** 0.5) + 1):
            if spf[i] == i:
                for j in range(i * i, MAXV, i):
                    if spf[j] == j:
                        spf[j] = i

        def get_factors(x):
            factors = set()

            while x > 1:
                p = spf[x]
                factors.add(p)

                while x % p == 0:
                    x //= p

            return factors

        groups = defaultdict(list)

        for i, x in enumerate(nums):
            for p in get_factors(x):
                groups[p].append(i)

        q = deque([0])
        visited = [False] * n
        visited[0] = True

        steps = 0

        while q:
            for _ in range(len(q)):
                i = q.popleft()

                if i == n - 1:
                    return steps

                if i - 1 >= 0 and not visited[i - 1]:
                    visited[i - 1] = True
                    q.append(i - 1)

                if i + 1 < n and not visited[i + 1]:
                    visited[i + 1] = True
                    q.append(i + 1)

                if len(get_factors(nums[i])) == 1 and nums[i] > 1:
                    p = nums[i]

                    if p in groups:
                        for nxt in groups[p]:
                            if not visited[nxt]:
                                visited[nxt] = True
                                q.append(nxt)

                        del groups[p]

            steps += 1

        return -1

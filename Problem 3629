from collections import defaultdict, deque

class Solution:
    def minJumps(self, nums):
        n = len(nums)

        def isPrime(x):
            if x < 2:
                return False

            i = 2
            while i * i <= x:
                if x % i == 0:
                    return False
                i += 1

            return True

        groups = defaultdict(list)

        for i, num in enumerate(nums):
            for p in range(2, int(num ** 0.5) + 1):
                if num % p == 0:
                    groups[p].append(i)

                    while num % p == 0:
                        num //= p

            if num > 1:
                groups[num].append(i)

        q = deque([(0, 0)])
        visited = set([0])
        usedPrime = set()

        while q:
            i, steps = q.popleft()

            if i == n - 1:
                return steps

            if i + 1 < n and i + 1 not in visited:
                visited.add(i + 1)
                q.append((i + 1, steps + 1))

            if i - 1 >= 0 and i - 1 not in visited:
                visited.add(i - 1)
                q.append((i - 1, steps + 1))

            val = nums[i]

            if isPrime(val) and val not in usedPrime:
                usedPrime.add(val)

                for nxt in groups[val]:
                    if nxt not in visited:
                        visited.add(nxt)
                        q.append((nxt, steps + 1))

        return -1

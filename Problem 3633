class Solution {
public:
    int earliestFinishTime(vector<int>& landStartTime,
                           vector<int>& landDuration,
                           vector<int>& waterStartTime,
                           vector<int>& waterDuration) {

        int ans = INT_MAX;

        int n = landStartTime.size();
        int m = waterStartTime.size();

        // Land first -> Water
        for (int i = 0; i < n; i++) {
            int landEnd = landStartTime[i] + landDuration[i];

            for (int j = 0; j < m; j++) {
                int waterStart = max(landEnd, waterStartTime[j]);
                int finish = waterStart + waterDuration[j];

                ans = min(ans, finish);
            }
        }

        // Water first -> Land
        for (int j = 0; j < m; j++) {
            int waterEnd = waterStartTime[j] + waterDuration[j];

            for (int i = 0; i < n; i++) {
                int landStart = max(waterEnd, landStartTime[i]);
                int finish = landStart + landDuration[i];

                ans = min(ans, finish);
            }
        }

        return ans;
    }
};

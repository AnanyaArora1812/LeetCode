class Solution(object):
    def longestCommonPrefix(self, arr1, arr2):
        prefixes = set()

        # Store all prefixes from arr1
        for num in arr1:
            s = str(num)
            prefix = ""

            for ch in s:
                prefix += ch
                prefixes.add(prefix)

        max_len = 0

        # Check prefixes in arr2
        for num in arr2:
            s = str(num)
            prefix = ""

            for ch in s:
                prefix += ch

                if prefix in prefixes:
                    max_len = max(max_len, len(prefix))
                else:
                    break

        return max_len

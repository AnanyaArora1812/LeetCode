class Solution {
    public int countDigits(int num){
        int n = num;
        int val = 0;
        int count = 0;
        while(n != 0){
            val = n % 10;
            n = n / 10;
            if (val != 0 && num % val == 0){
                count ++;
            }
        }
    return count;
    }
}

class Solution:
    def rotateTheBox(self, box):
        m, n = len(box), len(box[0])

        # simulate gravity (rightwards)
        for i in range(m):
            empty = n - 1
            for j in range(n - 1, -1, -1):
                if box[i][j] == '*':
                    empty = j - 1
                elif box[i][j] == '#':
                    box[i][j], box[i][empty] = '.', '#'
                    empty -= 1

        # rotate 90 degrees clockwise
        res = [[None] * m for _ in range(n)]
        for i in range(m):
            for j in range(n):
                res[j][m - 1 - i] = box[i][j]

        return res

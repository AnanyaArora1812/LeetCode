class Solution:
    def areSimilar(self, mat, k):
        m, n = len(mat), len(mat[0])
        k %= n

        for i in range(m):
            if i % 2 == 0:  # even row → left shift
                if mat[i][k:] + mat[i][:k] != mat[i]:
                    return False
            else:  # odd row → right shift
                if mat[i][-k:] + mat[i][:-k] != mat[i]:
                    return False

        return True
